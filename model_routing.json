{
  "roles": {
    "issue_classifier": {
      "default": {
        "model": "meta/llama-3.3-70b-instruct",
        "api_key_env": "NVIDIA_API_KEY_CLASSIFIER",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 0.2,
        "max_tokens": 1024
      },
      "fallback_models": ["meta/llama-3.3-70b-instruct"]
    },
    "repo_analyst": {
      "default": {
        "model": "qwen/qwen3.5-122b-a10b",
        "api_key_env": "NVIDIA_API_KEY_ANALYST",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 0.6,
        "max_tokens": 16384
      },
      "fallback_models": ["meta/llama-3.3-70b-instruct"]
    },
    "context_curator": {
      "default": {
        "model": "qwen/qwen3.5-122b-a10b",
        "api_key_env": "NVIDIA_API_KEY_ANALYST",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 0.6,
        "max_tokens": 16384
      },
      "fallback_models": ["meta/llama-3.3-70b-instruct"]
    },
    "planner": {
      "default": {
        "model": "z-ai/glm-5.1",
        "api_key_env": "NVIDIA_API_KEY_PLANNER",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 1.0,
        "max_tokens": 16384
      },
      "overrides": [
        {
          "condition": {"retry_count": ">2"},
          "model": "qwen/qwen3.5-122b-a10b",
          "api_key_env": "NVIDIA_API_KEY_ANALYST"
        }
      ],
      "fallback_models": ["qwen/qwen3.5-122b-a10b", "meta/llama-3.3-70b-instruct"]
    },
    "implementation": {
      "default": {
        "model": "openai/gpt-oss-120b",
        "api_key_env": "NVIDIA_API_KEY_CODER",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 1.0,
        "max_tokens": 4096
      },
      "fallback_models": ["deepseek-ai/deepseek-v4-flash", "qwen/qwen3.5-122b-a10b"]
    },
    "bugfix_retry": {
      "default": {
        "model": "deepseek-ai/deepseek-v4-flash",
        "api_key_env": "NVIDIA_API_KEY_BUGFIX",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 1.0,
        "max_tokens": 16384,
        "extra_body": {
          "chat_template_kwargs": {"thinking": true, "reasoning_effort": "high"}
        }
      },
      "overrides": [
        {
          "condition": {"retry_count": ">2"},
          "model": "openai/gpt-oss-120b",
          "api_key_env": "NVIDIA_API_KEY_CODER"
        }
      ],
      "fallback_models": ["openai/gpt-oss-120b", "qwen/qwen3.5-122b-a10b"]
    },
    "test_generator": {
      "default": {
        "model": "qwen/qwen3.5-122b-a10b",
        "api_key_env": "NVIDIA_API_KEY_ANALYST",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 0.6,
        "max_tokens": 16384
      },
      "fallback_models": ["meta/llama-3.3-70b-instruct"]
    },
    "reviewer": {
      "default": {
        "model": "nvidia/nemotron-3-ultra-550b-a55b",
        "api_key_env": "NVIDIA_API_KEY_REVIEWER",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 1.0,
        "max_tokens": 16384,
        "extra_body": {
          "chat_template_kwargs": {"enable_thinking": true},
          "reasoning_budget": 16384
        }
      },
      "fallback_models": ["z-ai/glm-5.1", "qwen/qwen3.5-122b-a10b"]
    },
    "final_verifier": {
      "default": {
        "model": "z-ai/glm-5.1",
        "api_key_env": "NVIDIA_API_KEY_PLANNER",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 1.0,
        "max_tokens": 16384
      },
      "fallback_models": ["qwen/qwen3.5-122b-a10b", "meta/llama-3.3-70b-instruct"]
    },
    "self_critique": {
      "default": {
        "model": "nvidia/nemotron-3-ultra-550b-a55b",
        "api_key_env": "NVIDIA_API_KEY_REVIEWER",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 0.5,
        "max_tokens": 8192
      },
      "fallback_models": ["z-ai/glm-5.1"]
    },
    "debugger": {
      "default": {
        "model": "deepseek-ai/deepseek-v4-flash",
        "api_key_env": "NVIDIA_API_KEY_BUGFIX",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "temperature": 0.5,
        "max_tokens": 16384,
        "extra_body": {
          "chat_template_kwargs": {"thinking": true, "reasoning_effort": "high"}
        }
      },
      "fallback_models": ["openai/gpt-oss-120b"]
    }
  }
}
